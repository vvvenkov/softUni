{{setTitle "Details"}}

<article class="product-detail">
    <img src="{{product.image}}">
    <h2>{{product.name}}</h2>
    <p>{{product.description}}</p>

    <h3>|~|~|~|~|~|~|~|~|~|~|~|~|~|~|~|</h3>

    <h3>Key Ingredients:</h3>
    <p>{{showIngredients product.ingredients}}</p>

    <h3>|~|~|~|~|~|~|~|~|~|~|~|~|~|~|~|</h3>

    <h3>Benefits:</h3>
    <p>{{product.benefits}} </p>

    <h3>|~|~|~|~|~|~|~|~|~|~|~|~|~|~|~|</h3>

    <h3>Skin Type:</h3>
    <p>{{product.skin}}</p>

    <h3>|~|~|~|~|~|~|~|~|~|~|~|~|~|~|~|</h3>

    <h3>Price: ${{product.price}}</h3>

    <h3>|~|~|~|~|~|~|~|~|~|~|~|~|~|~|~|</h3>

    <h3>People Who Recommend: {{recommendCount}}</h3>
</article>

{{#if isAuthenticated}}
<div class="command">
    {{#if isOwner}}
    <a href="#">Edit</a>
    <a href="#">Delete</a>
    {{else if isRecommended}}
    <p>You've already recommenden this product!</p>
    {{else}}
    <a href="/products/{{product.id}}/recommend">Recommend</a>
    {{/if}}
</div>
{{/if}}