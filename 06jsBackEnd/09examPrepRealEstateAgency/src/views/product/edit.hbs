<!-- Edit Page (Only for logged-in users) -->
<section id="edit">
    <div class="form">
        <h2>Edit Property Info</h2>
        <form method="post" class="edit-form">
            <input type="text" id="type" name="type" value="{{product.type}}" />
            <input type="text" id="location" name="location" value="{{product.location}}" />
            <input type="number" id="area" name="area" value="{{product.area}}" />
            <input type="text" id="image-url" name="image" value="{{product.image}}" />
            <input type="number" id="price" name="price" value="{{product.price}}" />
            <input type="number" id="contact" name="contact" value="{{product.contact}}" />
            <textarea id="description" name="description">{{product.description}}</textarea>

            <button type="submit">Edit</button>
        </form>

    </div>
</section>