<section id="details">
    <div id="details-wrapper">
        <p id="details-title">House</p>
        <div id="img-wrapper">
            <img src={{product.image}} alt={{product.description}} />
        </div>
        <div id="info-wrapper">
            <table>

                <tr>
                    <td>
                        <p>
                            Contact: <a id="details-contact">{{product.contact}}</a>
                        </p>
                    </td>
                    <td>
                        <p>Location: <span id="details-location">{{product.location}}</span></p>
                    </td>
                </tr>
                <tr>
                    <td>
                        <p>Area: <span id="details-area">{{product.area}}</span></p>
                    </td>
                    <td>
                        <p>Price: <span id="details-price">{{product.price}}</p>
                    </td>
                </tr>
            </table>
            <p>Description:
                <span id="details-description">
                    {{product.description}}
                </span>
            </p>
        </div>

        {{#if isAuthenticated}}
        <div id="action-buttons">
            {{#if isOwner}}
            <a href="/product/{{product._id}}/edit" id="edit-btn">Edit</a>
            <a href="/product/{{product._id}}/delete" id="delete-btn">Delete</a>
            {{else if isLiked}}
            <p id="already-liked">You already liked this property!</p>
            {{else}}
            <a href="/product/{{product._id}}/like" id="like-btn">Like</a>
            {{/if}}
        </div>
        {{/if}}
</section>